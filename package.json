{
  "name": "fontstay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Generator of metric-adjusted fallback font stacks with live preview and CLS estimation",
  "license": "MIT",
  "repository": "github:fogrew/fontstay.dev",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/pwa/build-pwa.mjs",
    "preview": "astro preview",
    "check": "pnpm i18n:compile && astro check",
    "astro": "astro",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "lefthook install || exit 0",
    "lint:arch": "node scripts/lint-arch.ts",
    "verify": "pnpm lint && pnpm lint:arch && pnpm check && pnpm test && pnpm build && pnpm perf",
    "test": "pnpm i18n:compile && vitest run",
    "test:watch": "pnpm i18n:compile && vitest",
    "test:e2e": "pnpm build && playwright test && playwright test --config tests/worker/playwright.config.ts && playwright test --config tests/ui/playwright.config.ts",
    "changelog": "git-cliff --output CHANGELOG.md",
    "release": "node scripts/release.ts",
    "i18n:compile": "node scripts/i18n-compile.mjs",
    "i18n:add": "node scripts/i18n-add.ts",
    "compat:build": "node scripts/compat/build-descriptors.ts",
    "os-fonts:import": "node scripts/os-fonts/import.ts",
    "google-fonts:catalog": "node scripts/font-sources/import-google-catalog.mjs",
    "fontsource:catalog": "node scripts/font-sources/import-fontsource-catalog.mjs",
    "perf": "node scripts/check-budget.mjs",
    "icons:build": "node scripts/pwa/build-icons.mjs",
    "og:build": "node scripts/og/build-og.mjs",
    "unicode:blocks": "node scripts/unicode/import-blocks.mjs",
    "os-fonts:metrics": "node scripts/os-fonts/extract-metrics.mjs",
    "postinstall": "pnpm i18n:compile"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.6",
    "@preact/signals": "2.11.3",
    "astro": "7.3.8",
    "browserslist": "4.29.3",
    "fontkitten": "1.0.3",
    "preact": "10.29.8",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@feod/analyzer": "0.1.1",
    "@inlang/paraglide-js": "2.26.0",
    "@inlang/plugin-message-format": "4.4.5",
    "@mdn/browser-compat-data": "8.1.5",
    "@playwright/test": "1.64.0",
    "fast-check": "4.10.2",
    "git-cliff": "2.14.2",
    "lefthook": "2.2.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
