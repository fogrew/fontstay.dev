---
import { assertIsLocale, getTextDirection, locales, localizeHref, messagesFor } from '@/common/i18n';
import '../../styles/tokens.css';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = assertIsLocale(Astro.params.locale);
const t = messagesFor(locale);
---

<html lang={locale} dir={getTextDirection(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{t.import_page_title()}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="ff-page" data-import data-locale={locale} data-failed={t.import_nothing()}>
      <p role="status" data-status>{t.import_receiving()}</p>
      <p hidden data-home><a href={localizeHref('/', { locale })}>{t.import_back()}</a></p>
    </main>
    <script>
      import { runReceivePage } from '@/modules/site-import';

      const root = document.querySelector<HTMLElement>('[data-import]');
      if (root) runReceivePage(root);
    </script>
  </body>
</html>
