---
import { assertIsLocale, locales } from '@/common/i18n';
import { PresetsPage } from '@/pages/presets';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = assertIsLocale(Astro.params.locale);
---

<BaseLayout {locale} path="/presets/" page="presets">
  <PresetsPage {locale} />
</BaseLayout>
