---
import { assertIsLocale, locales, messagesFor } from '@/common/i18n';
import { PresetsPage } from '@/pages/presets';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = assertIsLocale(Astro.params.locale);
const t = messagesFor(locale);
---

<BaseLayout
  {locale}
  path="/presets/"
  page="presets"
  title={t.seo_presets_title()}
  description={t.seo_presets_description()}
>
  <PresetsPage {locale} />
</BaseLayout>
