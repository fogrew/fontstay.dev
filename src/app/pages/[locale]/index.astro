---
import { assertIsLocale, locales } from '@/common/i18n';
import { HomePage } from '@/pages/home';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = assertIsLocale(Astro.params.locale);
Astro.csp?.insertScriptResource("'self'");
Astro.csp?.insertScriptResource("'wasm-unsafe-eval'");
---

<BaseLayout {locale} path="/">
  <script is:inline slot="head" src="/dock-restore.js"></script>
  <HomePage {locale} />
</BaseLayout>
