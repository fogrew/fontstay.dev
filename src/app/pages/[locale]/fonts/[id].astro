---
import { assertIsLocale, locales, messagesFor } from '@/common/i18n';
import { osFontsDataset } from '@/modules/os-fonts';
import { FontPage } from '@/pages/catalog';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    osFontsDataset.fonts.map((font) => ({ params: { locale, id: font.id } })),
  );
}

const locale = assertIsLocale(Astro.params.locale);
const id = Astro.params.id ?? '';
const t = messagesFor(locale);
const family = osFontsDataset.fonts.find((font) => font.id === id)?.family ?? id;
---

<BaseLayout
  {locale}
  path={`/fonts/${id}/`}
  page="fonts"
  title={t.seo_font_title({ family })}
  description={t.seo_font_description({ family })}
>
  <FontPage {locale} {id} />
</BaseLayout>
