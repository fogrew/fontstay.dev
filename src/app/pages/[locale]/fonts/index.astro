---
import { assertIsLocale, locales, messagesFor } from '@/common/i18n';
import { CatalogPage } from '@/pages/catalog';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = assertIsLocale(Astro.params.locale);
const t = messagesFor(locale);
---

<BaseLayout
  {locale}
  path="/fonts/"
  page="fonts"
  title={t.seo_fonts_title()}
  description={t.seo_fonts_description()}
>
  <CatalogPage {locale} />
</BaseLayout>
