---
import { baseLocale, localizeHref } from '@/common/i18n';

const target = localizeHref('/', { locale: baseLocale });
---

<html lang={baseLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <noscript><meta http-equiv="refresh" content={`0; url=${target}`} /></noscript>
    <link rel="canonical" href={target} />
    <title>fontstay.dev</title>
  </head>
  <body>
    <a class="ff-link" href={target}>fontstay.dev</a>
    <script>
      import { localizeHref, pickLocale } from '@/common/i18n';

      location.replace(localizeHref('/', { locale: pickLocale(navigator.languages) }) + location.hash);
    </script>
  </body>
</html>
