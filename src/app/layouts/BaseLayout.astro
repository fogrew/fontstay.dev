---
import { getTextDirection, type Locale, locales, localizeHref, messagesFor } from '@/common/i18n';
import { Icon } from '@/common/ui';
import { LocaleSwitcher } from '@/modules/locale-switcher';
import { InstallButton, PwaManager } from '@/modules/pwa';
import '../styles/tokens.css';

interface Props {
  locale: Locale;
  path: string;
  headerActions?: boolean;
  page?: 'generator' | 'fonts' | 'presets' | 'guide' | 'credits' | 'changelog';
  title?: string;
  description?: string;
}

const {
  locale,
  path,
  headerActions = false,
  page = 'generator',
  title: pageTitle,
  description: pageDescription,
} = Astro.props;
const t = messagesFor(locale);
const canonical = new URL(localizeHref(path, { locale }), Astro.site);
const title = pageTitle ?? t.seo_home_title();
const description = pageDescription ?? t.seo_home_description();
const image = new URL('/og.png', Astro.site);
const ogLocale = locale === 'ru' ? 'ru_RU' : 'en_US';
const structured = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: t.app_title(),
  url: new URL(localizeHref('/', { locale }), Astro.site).toString(),
  description: t.seo_home_description(),
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  inLanguage: locale,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
});
const indexable = !process.env.WORKERS_CI_BRANCH || process.env.WORKERS_CI_BRANCH === 'main';
---

<html lang={locale} dir={getTextDirection(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#161a19" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f4f0" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.app_title()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.seo_image_alt()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="alternate" hreflang="x-default" href={new URL(localizeHref(path, { locale: 'en' }), Astro.site)} />
    <script type="application/ld+json" set:html={structured} />
    <link rel="canonical" href={canonical} />
    {locales.map((code) => (
      <link rel="alternate" hreflang={code} href={new URL(localizeHref(path, { locale: code }), Astro.site)} />
    ))}
    {!indexable && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="ff-skip-link" href="#main-content">{t.ui_skip_content()}</a>
    <header class="ff-header">
      <a class="ff-brand" href={localizeHref('/', { locale })}><img src="/favicon.svg" alt="" width="24" height="24" />{t.app_title()}</a>
      <nav aria-label={t.nav_label()}>
        <ul class="ff-header__nav">
          <li>
            <a href={localizeHref('/', { locale })} aria-current={page === 'generator' ? 'page' : undefined}>{t.nav_generator()}</a>
          </li>
          <li>
            <a href={localizeHref('/fonts/', { locale })} aria-current={page === 'fonts' ? 'page' : undefined}>{t.nav_fonts()}</a>
          </li>
          <li>
            <a href={localizeHref('/presets/', { locale })} aria-current={page === 'presets' ? 'page' : undefined}>{t.nav_presets()}</a>
          </li>
          <li>
            <a href={localizeHref('/guide/', { locale })} aria-current={page === 'guide' ? 'page' : undefined}>{t.nav_guide()}</a>
          </li>
        </ul>
      </nav>
      <div class="ff-header__end">
        {headerActions && (
          <div class="ff-header__actions">
            <button type="button" class="ff-button ff-button--secondary" id="ff-share" title={t.share_note()} disabled>
              <Icon name="share" />{t.share_copy_short()}
            </button>
            <button type="button" class="ff-button ff-button--secondary" id="ff-forget" disabled>
              <Icon name="forget" />{t.share_forget_short()}
            </button>
            <span class="ff-muted" id="ff-header-status" role="status"></span>
          </div>
        )}
        <InstallButton locale={locale} client:idle />
        <LocaleSwitcher current={locale} {path} />
        <a class="ff-header__link" href="https://github.com/fogrew/fontstay.dev"><Icon name="github" />{t.header_github()}</a>
      </div>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
    <PwaManager locale={locale} client:idle />
    {page !== 'generator' && (
      <footer class="ff-footer">
        <a href={localizeHref('/guide/', { locale })} aria-current={page === 'guide' ? 'page' : undefined}>{t.nav_guide()}</a>
        <a href={localizeHref('/credits/', { locale })} aria-current={page === 'credits' ? 'page' : undefined}>{t.nav_credits()}</a>
        <a href={localizeHref('/changelog/', { locale })} aria-current={page === 'changelog' ? 'page' : undefined}>{t.nav_changelog()}</a>
        <a href="https://github.com/fogrew/fontstay.dev"><Icon name="github" />{t.header_github()}</a>
      </footer>
    )}
  </body>
</html>

