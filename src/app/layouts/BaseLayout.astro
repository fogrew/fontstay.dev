---
import { catalogUrl, getTextDirection, type Locale, locales, localizeHref, messagesFor } from '@/common/i18n';
import { Icon } from '@/common/ui';
import { LocaleSwitcher } from '@/modules/locale-switcher';
import { PwaManager } from '@/modules/pwa';
import '../styles/tokens.css';

interface Props {
  locale: Locale;
  path: string;
  page?: 'generator' | 'fonts' | 'presets' | 'guide' | 'credits' | 'changelog';
  title?: string;
  description?: string;
}

const {
  locale,
  path,
  page = 'generator',
  title: pageTitle,
  description: pageDescription,
} = Astro.props;
const t = messagesFor(locale);
const canonical = new URL(localizeHref(path, { locale }), Astro.site);
const title = pageTitle ?? t.seo_home_title();
const description = pageDescription ?? t.seo_home_description();
const image = new URL('/og.png', Astro.site);
const ogLocale = { en: 'en_US', ru: 'ru_RU', ar: 'ar_AR', es: 'es_ES', 'pt': 'pt_BR' }[locale];
const structured = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: t.app_title(),
  url: new URL(localizeHref('/', { locale }), Astro.site).toString(),
  description: t.seo_home_description(),
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  inLanguage: locale,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
});
const indexable = !process.env.WORKERS_CI_BRANCH || process.env.WORKERS_CI_BRANCH === 'main';
---

<html lang={locale} dir={getTextDirection(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="fetch" href={catalogUrl(locale)} crossorigin="anonymous" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#161a19" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f4f0" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.app_title()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.seo_image_alt()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="alternate" hreflang="x-default" href={new URL(localizeHref(path, { locale: 'en' }), Astro.site)} />
    <script type="application/ld+json" set:html={structured} />
    <link rel="canonical" href={canonical} />
    {locales.map((code) => (
      <link rel="alternate" hreflang={code} href={new URL(localizeHref(path, { locale: code }), Astro.site)} />
    ))}
    {!indexable && <meta name="robots" content="noindex" />}
    <slot name="head" />
  </head>
  <body>
    <a class="ff-link ff-skip-link" href="#main-content">{t.ui_skip_content()}</a>
    <header class="ff-header" data-header>
      <a class="ff-link ff-link--tap ff-brand" href={localizeHref('/', { locale })}><img class="ff-brand__logo" src="/favicon.svg" alt="" width="24" height="24" />{t.app_title()}</a>
      <nav class="ff-header__menu" id="ff-nav" aria-label={t.nav_label()}>
        <ul class="ff-header__nav">
          <li>
            <a class="ff-link ff-link--tap ff-header__nav-link" href={localizeHref('/', { locale })} aria-current={page === 'generator' ? 'page' : undefined}>{t.nav_generator()}</a>
          </li>
          <li>
            <a class="ff-link ff-link--tap ff-header__nav-link" href={localizeHref('/fonts/', { locale })} aria-current={page === 'fonts' ? 'page' : undefined}>{t.nav_fonts()}</a>
          </li>
          <li>
            <a class="ff-link ff-link--tap ff-header__nav-link" href={localizeHref('/presets/', { locale })} aria-current={page === 'presets' ? 'page' : undefined}>{t.nav_presets()}</a>
          </li>
          <li>
            <a class="ff-link ff-link--tap ff-header__nav-link" href={localizeHref('/guide/', { locale })} aria-current={page === 'guide' ? 'page' : undefined}>{t.nav_guide()}</a>
          </li>
        </ul>
      </nav>
      <div class="ff-header__end">
        <a class="ff-link ff-link--tap ff-header__link" href="https://github.com/fogrew/fontstay.dev" title={t.header_github()}><Icon name="github" /><span class="ff-sr-only">{t.header_github()}</span></a>
        <div class="ff-header__group"><LocaleSwitcher current={locale} {path} /></div>
        <button class="ff-control ff-header__toggle" type="button" hidden aria-expanded="false" aria-controls="ff-nav" aria-label={t.nav_menu()} data-nav-toggle>
          <svg class="ff-icon" width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </button>
      </div>
    </header>
    <main class="ff-main" id="main-content" tabindex="-1"><slot /></main>
    <script>
      const header = document.querySelector<HTMLElement>('[data-header]');
      const toggle = header?.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const nav = header?.querySelector<HTMLElement>('#ff-nav');
      if (header && toggle && nav) {
        const wide = matchMedia('(min-width: 48rem)');
        const setOpen = (open: boolean) => {
          toggle.setAttribute('aria-expanded', String(open));
          header.dataset.menu = open ? 'open' : 'closed';
        };
        const locale = document.querySelector<HTMLDetailsElement>('[data-locale-menu]');
        toggle.hidden = false;
        setOpen(false);
        toggle.addEventListener('click', (event) => {
          const open = toggle.getAttribute('aria-expanded') !== 'true';
          if (open && locale) locale.open = false;
          setOpen(open);
          if (open && event.detail === 0) nav.querySelector<HTMLElement>('a')?.focus();
        });
        document.addEventListener('click', (event) => {
          if (!header.contains(event.target as Node)) setOpen(false);
        });
        locale?.addEventListener('toggle', () => {
          if (locale.open) setOpen(false);
        });
        header.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape' || toggle.getAttribute('aria-expanded') !== 'true') return;
          setOpen(false);
          toggle.focus();
        });
        header.addEventListener('focusout', (event) => {
          const next = event.relatedTarget as Node | null;
          if (next && !header.contains(next)) setOpen(false);
        });
        wide.addEventListener('change', () => setOpen(false));
      }
    </script>
    <PwaManager locale={locale} client:idle />
    {page !== 'generator' && (
      <footer class="ff-footer">
        <a class="ff-link ff-link--tap" href={localizeHref('/guide/', { locale })} aria-current={page === 'guide' ? 'page' : undefined}>{t.nav_guide()}</a>
        <a class="ff-link ff-link--tap" href={localizeHref('/credits/', { locale })} aria-current={page === 'credits' ? 'page' : undefined}>{t.nav_credits()}</a>
        <a class="ff-link ff-link--tap" href={localizeHref('/changelog/', { locale })} aria-current={page === 'changelog' ? 'page' : undefined}>{t.nav_changelog()}</a>
        <a class="ff-link ff-link--tap" href="https://github.com/fogrew/fontstay.dev"><Icon name="github" />{t.header_github()}</a>
      </footer>
    )}
  </body>
</html>

