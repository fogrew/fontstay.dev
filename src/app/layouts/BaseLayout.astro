---
import { getTextDirection, type Locale, locales, localizeHref, messagesFor } from '@/common/i18n';
import { LocaleSwitcher } from '@/modules/locale-switcher';
import '../styles/tokens.css';

interface Props {
  locale: Locale;
  path: string;
  settingsToggle?: boolean;
}

const { locale, path, settingsToggle = false } = Astro.props;
const t = messagesFor(locale);
const canonical = new URL(localizeHref(path, { locale }), Astro.site);
const indexable = !process.env.WORKERS_CI_BRANCH || process.env.WORKERS_CI_BRANCH === 'main';
---

<html lang={locale} dir={getTextDirection(locale)} data-settings="open">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.app_title()}</title>
    <link rel="canonical" href={canonical} />
    {locales.map((code) => (
      <link rel="alternate" hreflang={code} href={new URL(localizeHref(path, { locale: code }), Astro.site)} />
    ))}
    {!indexable && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="ff-skip-link" href="#main-content">{t.ui_skip_content()}</a>
    <header class="ff-header">
      {settingsToggle && (
        <button
          type="button"
          class="ff-burger"
          aria-controls="ff-settings"
          aria-expanded="true"
          aria-label={t.shell_hide_settings()}
          data-label-open={t.shell_hide_settings()}
          data-label-closed={t.shell_show_settings()}
          data-settings-toggle
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
      )}
      <a class="ff-brand" href={localizeHref('/', { locale })}>{t.app_title()}</a>
      <div class="ff-header__end">
        <LocaleSwitcher current={locale} {path} />
        <a class="ff-header__link" href="https://github.com/fogrew/fontstay.dev">{t.header_github()}</a>
      </div>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
  </body>
</html>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-settings-toggle]');
  button?.addEventListener('click', () => {
    const root = document.documentElement;
    const open = root.dataset.settings === 'closed';
    root.dataset.settings = open ? 'open' : 'closed';
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', (open ? button.dataset.labelOpen : button.dataset.labelClosed) ?? '');
  });
</script>
