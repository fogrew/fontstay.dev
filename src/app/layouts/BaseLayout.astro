---
import { getTextDirection, type Locale, locales, localizeHref, messagesFor } from '@/common/i18n';
import { LocaleSwitcher } from '@/modules/locale-switcher';
import '../styles/tokens.css';

interface Props {
  locale: Locale;
  path: string;
  settingsToggle?: boolean;
  page?: 'generator' | 'fonts' | 'presets';
  title?: string;
  description?: string;
}

const {
  locale,
  path,
  settingsToggle = false,
  page = 'generator',
  title: pageTitle,
  description: pageDescription,
} = Astro.props;
const t = messagesFor(locale);
const canonical = new URL(localizeHref(path, { locale }), Astro.site);
const title = pageTitle ?? t.seo_home_title();
const description = pageDescription ?? t.seo_home_description();
const image = new URL('/og.png', Astro.site);
const ogLocale = locale === 'ru' ? 'ru_RU' : 'en_US';
const structured = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: t.app_title(),
  url: new URL(localizeHref('/', { locale }), Astro.site).toString(),
  description: t.seo_home_description(),
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  inLanguage: locale,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
});
const indexable = !process.env.WORKERS_CI_BRANCH || process.env.WORKERS_CI_BRANCH === 'main';
---

<html lang={locale} dir={getTextDirection(locale)} data-settings="open">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#161a19" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f4f0" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.app_title()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.seo_image_alt()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="alternate" hreflang="x-default" href={new URL(localizeHref(path, { locale: 'en' }), Astro.site)} />
    <script type="application/ld+json" set:html={structured} />
    <link rel="canonical" href={canonical} />
    {locales.map((code) => (
      <link rel="alternate" hreflang={code} href={new URL(localizeHref(path, { locale: code }), Astro.site)} />
    ))}
    {!indexable && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="ff-skip-link" href="#main-content">{t.ui_skip_content()}</a>
    <header class="ff-header">
      {settingsToggle && (
        <button
          type="button"
          class="ff-burger"
          aria-controls="ff-settings"
          aria-expanded="true"
          aria-label={t.shell_hide_settings()}
          data-label-open={t.shell_hide_settings()}
          data-label-closed={t.shell_show_settings()}
          data-settings-toggle
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
      )}
      <a class="ff-brand" href={localizeHref('/', { locale })}>{t.app_title()}</a>
      <nav aria-label={t.nav_label()}>
        <ul class="ff-header__nav">
          <li>
            <a href={localizeHref('/', { locale })} aria-current={page === 'generator' ? 'page' : undefined}>{t.nav_generator()}</a>
          </li>
          <li>
            <a href={localizeHref('/fonts/', { locale })} aria-current={page === 'fonts' ? 'page' : undefined}>{t.nav_fonts()}</a>
          </li>
          <li>
            <a href={localizeHref('/presets/', { locale })} aria-current={page === 'presets' ? 'page' : undefined}>{t.nav_presets()}</a>
          </li>
        </ul>
      </nav>
      <div class="ff-header__end">
        <LocaleSwitcher current={locale} {path} />
        <a class="ff-header__link" href="https://github.com/fogrew/fontstay.dev">{t.header_github()}</a>
      </div>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
  </body>
</html>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-settings-toggle]');
  button?.addEventListener('click', () => {
    const root = document.documentElement;
    const open = root.dataset.settings === 'closed';
    root.dataset.settings = open ? 'open' : 'closed';
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', (open ? button.dataset.labelOpen : button.dataset.labelClosed) ?? '');
  });
</script>
