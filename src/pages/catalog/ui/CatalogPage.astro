---
import { type Locale, messagesFor } from '@/common/i18n';
import { CatalogTable } from '@/modules/catalog';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messagesFor(locale);
---

<div class="ff-page">
  <h1 class="ff-heading ff-page__heading">{t.catalog_heading()}</h1>
  <p class="ff-page__text">{t.catalog_intro()}</p>
  <CatalogTable locale={locale} client:load />
</div>
