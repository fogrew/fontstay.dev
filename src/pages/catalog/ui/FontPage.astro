---
import { type Locale, localizeHref, messagesFor } from '@/common/i18n';
import { catalogFontState, encodeShareState } from '@/modules/generator';
import { osAvailability, osFontMetrics, osFontsDataset } from '@/modules/os-fonts';

interface Props {
  locale: Locale;
  id: string;
}

const { locale, id } = Astro.props;
const t = messagesFor(locale);
const font = osFontsDataset.fonts.find((item) => item.id === id);
if (!font) throw new Error(`Unknown font ${id}`);
const metrics = osFontMetrics().find((item) => item.id === id);
const generatorState = catalogFontState(id);
const generatorHref = generatorState
  ? `${localizeHref('/', { locale })}#s=${await encodeShareState(generatorState)}`
  : undefined;
const systems = ['windows', 'macos', 'linux', 'chromeos', 'android', 'ios'] as const;
const percent = (value: number) =>
  new Intl.NumberFormat(locale, { maximumFractionDigits: 1 }).format(value * 100);
const levelLabel = (level: string) => {
  if (level === 'preinstalled') return t.catalog_level_preinstalled();
  if (level === 'partial') return t.catalog_level_partial();
  return level === 'on-demand' ? t.catalog_level_on_demand() : t.catalog_level_unknown();
};
const vertical = metrics
  ? {
      ascent: metrics.hhea.ascent / metrics.unitsPerEm,
      descent: Math.abs(metrics.hhea.descent) / metrics.unitsPerEm,
      lineGap: Math.max(0, metrics.hhea.lineGap) / metrics.unitsPerEm,
    }
  : undefined;
---

<div class="ff-page">
  <nav aria-label={t.breadcrumbs_label()}>
    <ol class="ff-breadcrumbs">
      <li class="ff-breadcrumbs__item"><a class="ff-link ff-link--tap" href={localizeHref('/', { locale })}>{t.nav_generator()}</a></li>
      <li class="ff-breadcrumbs__item"><a class="ff-link ff-link--tap" href={localizeHref('/fonts/', { locale })}>{t.nav_fonts()}</a></li>
      <li class="ff-breadcrumbs__item" aria-current="page">{font.family}</li>
    </ol>
  </nav>
  <h1 class="ff-heading ff-page__heading">{font.family}</h1>
  <p class="ff-page__text">{font.category === 'serif' ? t.type_serif() : font.category === 'monospace' ? t.type_mono() : font.category === 'cursive' ? t.type_cursive() : t.type_sans()}</p>
  {generatorHref ? (
    <>
      <p class="ff-page__text"><a class="ff-link ff-link--tap" href={generatorHref}>{t.catalog_generator_open({ name: font.family })}</a></p>
      <p class="ff-page__text ff-muted">{t.catalog_generator_note({ name: font.family })}</p>
    </>
  ) : (
    <p class="ff-page__text ff-muted">{t.catalog_generator_unavailable()}</p>
  )}

  <h2 class="ff-heading ff-page__heading">{t.font_specimen_heading()}</h2>
  <link rel="stylesheet" href="/specimens/fonts.css" />
  <p class="ff-page__text ff-specimen" data-font={font.id}>{t.preview_sample_default()}</p>
  <p class="ff-page__text ff-specimen" data-font={font.id}>ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz 0123456789</p>
  <p class="ff-page__text ff-muted">{t.font_specimen_note()}</p>

  <h2 class="ff-heading ff-page__heading">{t.font_availability_heading()}</h2>
  <table class="ff-page__table">
    <thead>
      <tr>
        <th class="ff-page__cell" scope="col">{t.catalog_col_system()}</th>
        <th class="ff-page__cell" scope="col">{t.catalog_col_availability()}</th>
        <th class="ff-page__cell" scope="col">{t.font_versions()}</th>
      </tr>
    </thead>
    <tbody>
      {systems.map((os) => {
        const result = osAvailability(font, os, osFontsDataset);
        return (
          <tr>
            <th class="ff-page__cell" scope="row">{t[`audience_os_${os}`]()}</th>
            <td class="ff-page__cell">{levelLabel(result.level)}</td>
            <td class="ff-page__cell">{result.present.join(', ') || '—'}</td>
          </tr>
        );
      })}
    </tbody>
  </table>
  <h3 class="ff-heading ff-page__heading">{t.font_sources_heading()}</h3>
  <ul class="ff-page__list">
    {[...new Set(font.availability.map((entry) => entry.source))].map((source) => (
      <li class="ff-page__item"><a class="ff-link ff-link--tap" href={source} rel="noopener noreferrer">{source}</a></li>
    ))}
  </ul>

  <h2 class="ff-heading ff-page__heading">{t.font_metrics_heading()}</h2>
  {vertical && metrics ? (
    <dl class="ff-page__metrics">
      <dt>{t.font_metrics_names()}</dt>
      <dd class="ff-page__value">{metrics.localNames.join(', ')}</dd>
      <dt>{t.font_metrics_units()}</dt>
      <dd class="ff-page__value">{metrics.unitsPerEm}</dd>
      <dt>{t.font_metrics_ascent()}</dt>
      <dd class="ff-page__value">{percent(vertical.ascent)}%</dd>
      <dt>{t.font_metrics_descent()}</dt>
      <dd class="ff-page__value">{percent(vertical.descent)}%</dd>
      <dt>{t.font_metrics_gap()}</dt>
      <dd class="ff-page__value">{percent(vertical.lineGap)}%</dd>
      <dt>{t.font_metrics_glyphs()}</dt>
      <dd class="ff-page__value">{metrics.codePoints.length}</dd>
    </dl>
  ) : (
    <p class="ff-page__text ff-muted">{t.font_no_metrics()}</p>
  )}
</div>
