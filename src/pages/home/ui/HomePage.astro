---
import { type Locale, messagesFor } from '@/common/i18n';
import { GeneratorApp } from '@/modules/generator';

interface Props {
  locale: Locale;
}

const t = messagesFor(Astro.props.locale);
---

<h1 class="ff-sr-only">{t.home_heading()}</h1>
<GeneratorApp locale={Astro.props.locale} client:load />
