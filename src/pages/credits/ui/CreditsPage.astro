---
import { compiledContent } from '@root/CREDITS.md';
import { type Locale, messagesFor } from '@/common/i18n';
import { addProseClasses } from '@/common/lib';

interface Props {
  locale: Locale;
}

const t = messagesFor(Astro.props.locale);
const html = addProseClasses(await compiledContent());
---

<div class="ff-page ff-prose">
  <p class="ff-page__text ff-muted">{t.credits_note()}</p>
  <Fragment set:html={html} />
</div>
