---
import { type Locale, localeName, locales, localizeHref, messagesFor } from '@/common/i18n';

interface Props {
  current: Locale;
  path: string;
}

const { current } = Astro.props;
const path = Astro.props.path.endsWith('/') ? Astro.props.path : `${Astro.props.path}/`;
const t = messagesFor(current);
---

<nav class="ff-locale" aria-label={t.locale_switcher_label()}>
  <details class="ff-locale__menu" data-locale-menu>
    <summary class="ff-locale__summary" title={t.locale_switcher_label()}>
      <svg class="ff-locale__icon" width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M3 12h18" /><ellipse cx="12" cy="12" rx="4" ry="9" /></g></svg>
      <span class="ff-sr-only">{t.locale_switcher_label()}: <span lang={current}>{localeName(current)}</span></span>
    </summary>
    <ul class="ff-locale__list">
      {
        locales.map((locale) => (
          <li>
            <a
              class="ff-link ff-locale__link"
              href={localizeHref(path, { locale })}
              data-locale-link
              hreflang={locale}
              lang={locale}
              aria-current={locale === current ? 'true' : undefined}
            >
              {localeName(locale)}
            </a>
          </li>
        ))
      }
    </ul>
  </details>
</nav>

<style>
  .ff-locale {
    position: relative;
  }

  .ff-locale__summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 2rem;
    min-inline-size: 2rem;
    padding: 0.25rem;
    border: 1px solid transparent;
    border-radius: var(--ff-radius);
    line-height: 1;
    list-style: none;
    cursor: pointer;
  }

  .ff-locale__summary::-webkit-details-marker {
    display: none;
  }

  .ff-locale__icon {
    inline-size: 1.25em;
    block-size: 1.25em;
  }

  .ff-locale__summary:hover {
    background: color-mix(in srgb, var(--ff-accent) 12%, transparent);
  }

  .ff-locale__menu[open] > .ff-locale__summary {
    border-color: var(--ff-accent);
    background: color-mix(in srgb, var(--ff-accent) 18%, transparent);
    color: var(--ff-accent);
  }

  .ff-locale__list {
    position: absolute;
    inset-block-start: 100%;
    inset-inline-end: 0;
    z-index: 40;
    display: grid;
    gap: 0.125rem;
    min-inline-size: 100%;
    max-block-size: min(24rem, 70dvh);
    margin: 0.25rem 0 0;
    padding: 0.25rem;
    overflow-y: auto;
    scrollbar-gutter: stable;
    border: 1px solid var(--ff-border);
    border-radius: var(--ff-radius);
    background: var(--ff-surface);
    box-shadow: 0 8px 24px rgb(0 0 0 / 20%);
    list-style: none;
  }

  .ff-locale__link {
    display: block;
    min-block-size: 2rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--ff-radius);
    line-height: 1.5;
    text-align: end;
    text-decoration: none;
    white-space: nowrap;
  }

  .ff-locale__link:hover {
    background: color-mix(in srgb, var(--ff-accent) 12%, transparent);
  }

  .ff-locale__link[aria-current="true"] {
    background: color-mix(in srgb, var(--ff-accent) 18%, transparent);
    font-weight: 700;
  }

  @media (forced-colors: active) {
    .ff-locale__menu[open] > .ff-locale__summary,
    .ff-locale__link:hover,
    .ff-locale__link[aria-current="true"] {
      outline: 2px solid Highlight;
    }
  }
</style>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('a[data-locale-link]');
  for (const link of links) {
    link.dataset.base = link.getAttribute('href') ?? '';
  }
  const syncHash = () => {
    for (const link of links) {
      link.href = (link.dataset.base ?? '') + location.hash;
    }
  };
  syncHash();
  addEventListener('hashchange', syncHash);

  const menu = document.querySelector<HTMLDetailsElement>('details[data-locale-menu]');
  menu?.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !menu.open) return;
    menu.open = false;
    menu.querySelector('summary')?.focus();
  });
  menu?.addEventListener('focusout', (event) => {
    const next = event.relatedTarget as Node | null;
    if (menu.open && next && !menu.contains(next)) menu.open = false;
  });
  document.addEventListener('click', (event) => {
    if (menu?.open && !menu.contains(event.target as Node)) menu.open = false;
  });
</script>
