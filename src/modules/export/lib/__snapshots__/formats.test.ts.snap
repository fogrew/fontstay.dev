{
  "fileName": "font.ts",
  "language": "ts",
  "text": "// Put Inter-Regular.woff2 into ./fonts/ and the @font-face rules from the CSS export into your global CSS.
import localFont from 'next/font/local';

export const font = localFont({
  src: './fonts/Inter-Regular.woff2',
  display: 'swap',
  adjustFontFallback: false,
  fallback: ['Inter Fallback Arial', 'sans-serif'],
  variable: '--font-body',
});",
}
`;

exports[`buildExport > produces a stable next export for several families 1`] = `
{
  "fileName": "font.ts",
  "language": "ts",
  "text": "// Put Inter-Regular.woff2, Merriweather-Regular.woff2, Merriweather-Bold.woff2, Merriweather-Italic.woff2 into ./fonts/ and the @font-face rules from the CSS export into your global CSS.
import localFont from 'next/font/local';

export const inter = localFont({
  src: './fonts/Inter-Regular.woff2',
  display: 'swap',
  adjustFontFallback: false,
  fallback: ['Inter Fallback Arial', 'sans-serif'],
  variable: '--font-inter',
});

export const merriweather = localFont({
  src: [
    { path: './fonts/Merriweather-Regular.woff2', weight: '400', style: 'normal' },
    { path: './fonts/Merriweather-Bold.woff2', weight: '700', style: 'normal' },
    { path: './fonts/Merriweather-Italic.woff2', weight: '400', style: 'italic' },
  ],
  display: 'swap',
  adjustFontFallback: false,
  fallback: ['Merriweather Fallback Georgia', 'serif'],
  variable: '--font-merriweather',
});",
}
`;

