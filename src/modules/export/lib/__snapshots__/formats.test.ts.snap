exports[`buildExport > produces a stable next export 1`] = `
{
  "fileName": "font.ts",
  "language": "ts",
  "text": "// Put Inter-Regular.woff2 into ./fonts/ and the @font-face rules from the CSS export into your global CSS.
import localFont from 'next/font/local';

export const font = localFont({
  src: './fonts/Inter-Regular.woff2',
  display: 'swap',
  adjustFontFallback: false,
  fallback: ['Inter Fallback Arial', 'sans-serif'],
  variable: '--font-body',
});",
}
`;

exports[`buildExport > produces a stable nuxt export 1`] = `
{
  "fileName": "nuxt.config.ts",
  "language": "ts",
  "text": "// Add the @font-face rules from the CSS export to a stylesheet listed in \`css\`.
export default defineNuxtConfig({
  modules: ['@nuxt/fonts'],
  fonts: {
    families: [
      {
        name: 'Inter',
        src: '/fonts/Inter-Regular.woff2',
        fallbacks: ['Inter Fallback Arial', 'sans-serif'],
      },
    ],
  },
});",
}
`;

