exports[`buildExport > produces a stable astro export 1`] = `
{
  "fileName": "astro.config.mjs",
  "language": "js",
  "text": "// Add the @font-face rules from the CSS export to your global styles.
import { defineConfig } from 'astro/config';

export default defineConfig({
  fonts: [
    {
      name: 'Inter',
      cssVariable: '--font-body',
      provider: 'local',
      options: {
        variants: [{ weight: 400, style: 'normal', src: ['./src/assets/fonts/Inter-Regular.woff2'] }],
      },
      fallbacks: ['Inter Fallback Arial', 'sans-serif'],
    },
  ],
});",
}
`;

