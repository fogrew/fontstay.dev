  "language": "css",
  "text": "@font-face {
  font-family: "Inter Fallback Arial";
  src: local("Arial");
  size-adjust: 107.1194%;
}

:root {
  --font-body: "Inter", "Inter Fallback Arial", sans-serif;
}

body {
  font-family: var(--font-body);
  font-size-adjust: 0.4877;
  line-height: 1.4;
}",
}
