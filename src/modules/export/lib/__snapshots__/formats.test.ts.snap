exports[`buildExport > produces a stable fontaine export 1`] = `
{
  "fileName": "vite.config.ts",
  "language": "ts",
  "text": "// Put Inter-Regular.woff2 into ./public/fonts/ and declare their @font-face rules in your CSS. In Nuxt, put the plugin under vite.plugins.
import { FontaineTransform } from 'fontaine';
import { defineConfig } from 'vite';

export default defineConfig({
  plugins: [
    FontaineTransform.vite({
      fallbacks: {
        'Inter': ['Arial'],
      },
      resolvePath: (id) => new URL(\`./public\${id}\`, import.meta.url),
    }),
  ],
});",
}
`;

exports[`buildExport > produces a stable fontaine export for several families 1`] = `
{
  "fileName": "vite.config.ts",
  "language": "ts",
  "text": "// Put Inter-Regular.woff2, Merriweather-Regular.woff2, Merriweather-Bold.woff2, Merriweather-Italic.woff2 into ./public/fonts/ and declare their @font-face rules in your CSS. In Nuxt, put the plugin under vite.plugins.
import { FontaineTransform } from 'fontaine';
import { defineConfig } from 'vite';

export default defineConfig({
  plugins: [
    FontaineTransform.vite({
      fallbacks: {
        'Inter': ['Arial'],
        'Merriweather': ['Georgia', 'Times New Roman'],
      },
      resolvePath: (id) => new URL(\`./public\${id}\`, import.meta.url),
    }),
  ],
});",
}
`;

